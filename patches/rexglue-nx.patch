+DkImageRect RenderDk::RectFisico(const ImagenDk& imagen, uint32_t x, uint32_t y, uint32_t ancho, uint32_t alto,
+                                 uint32_t capa) {
+  const float e = imagen.escala;
+  if (e == 1.0f && imagen.fw() == imagen.ancho && imagen.fh() == imagen.alto) {
+    return {x, y, capa, ancho, alto, 1};
+  }
+  const uint32_t fw = imagen.fw(), fh = imagen.fh();
+  const uint32_t x0 = std::min(FisicoPiso(x, e), fw ? fw - 1 : 0), y0 = std::min(FisicoPiso(y, e), fh ? fh - 1 : 0);
+  const uint32_t x1 = std::clamp(FisicoCeil(x + ancho, e), x0 + 1, std::max(fw, x0 + 1));
+  const uint32_t y1 = std::clamp(FisicoCeil(y + alto, e), y0 + 1, std::max(fh, y0 + 1));
+  if (double(x) * e != double(x0) || double(y) * e != double(y0) || double(ancho) * e != double(x1 - x0) ||
+      double(alto) * e != double(y1 - y0)) {
+    AvisarEscala("redondeo de retangulo", x, y, (ancho << 16) ^ alto, false);
+  }
+  return {x0, y0, capa, x1 - x0, y1 - y0, 1};
+}
