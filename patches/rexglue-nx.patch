+    // The notification's box is as wide as its widest line plus a character of margin.
+    menu_ancho_usado_ =
+        filas_aviso ? std::min(kMenuAnchoHd, (derecha + kMenuCeldaHd + kMenuHd - 1) / kMenuHd * kMenuHd) : kMenuAnchoHd;
+    DkImageView v;
+    dkImageViewDefaults(&v, &menu_imagen_);
+    const DkCopyBuf origen = {subida.gpu, 0, 0};
+    const DkImageRect rect = {0, 0, 0, kMenuAnchoHd, kMenuAltoHd, 1};
+    dkCmdBufCopyBufferToImage(c, &origen, &v, &rect, 0);
+    dkCmdBufBarrier(c, DkBarrier_Full, DkInvalidateFlags_Image);
+    menu_version_ = version;
+    menu_filas_aviso_ = filas_aviso;
+    return true;
+  }
