+// ---- Live internal resolution (b3_deko_resolucao_interna) and its automatic controller
+
+uint32_t RenderDk::AlturaInternaDeseada() const {
+  const int32_t pedido = REXCVAR_GET(b3_deko_resolucao_interna);
+  uint32_t altura = pedido == 0 ? auto_altura_ : (pedido == 540 || pedido == 360) ? uint32_t(pedido) : 720u;
+  // The internal resolution never exceeds the output's height.
+  if (alto_salida_ && altura > alto_salida_) {
+    altura = alto_salida_ >= 720 ? 720u : alto_salida_ >= 540 ? 540u : 360u;
+  }
+  return altura;
+}
+
+void RenderDk::ControlarEscalaInterna() {
+  const int32_t pedido = REXCVAR_GET(b3_deko_resolucao_interna);
+  const uint64_t ahora = deko::AhoraNs();
+  if (pedido == 0) {
+    const uint64_t cuadros = fotograma_ - auto_fotograma_previo_;
+    if (cuadros >= 6) {
+      const bool medido = gpu_ns_ > auto_gpu_ns_previo_;
+      const double ms = double(gpu_ns_ - auto_gpu_ns_previo_) / 1e6 / double(cuadros);
+      auto_fotograma_previo_ = fotograma_;
+      auto_gpu_ns_previo_ = gpu_ns_;
+      if (auto_descartar_) {
+        --auto_descartar_;  // the windows right after a change include its own cost
+      } else if (medido && ms < 200.0) {
+        auto_gpu_ms_ = ms;
+        const double alvo = alvo_ms_ > 0 ? alvo_ms_ : 16.7;
+        // 0.1.44 hysteresis: hold 3 s after a change; down after ~1 s over the target, up after ~3 s with headroom.
+        const bool retenido = ahora - auto_cambio_ns_ < 3'000'000'000ull;
+        if (auto_altura_ == 720) {
+          if (ms > alvo * 0.95) {
+            if (auto_abajo_ns_ == 0) auto_abajo_ns_ = ahora;
+          } else {
+            auto_abajo_ns_ = 0;
+          }
+          auto_arriba_ns_ = 0;
+          if (auto_abajo_ns_ != 0 && ahora - auto_abajo_ns_ >= 1'000'000'000ull && !retenido) {
+            auto_altura_ = 540;
+          }
+        } else {
+          // 540 costs about 0.7 of 720 (not everything scales with the pixels): go back up when 720 would still fit.
+          if (ms * 1.4 < alvo * 0.9) {
+            if (auto_arriba_ns_ == 0) auto_arriba_ns_ = ahora;
+          } else {
+            auto_arriba_ns_ = 0;
+          }
+          auto_abajo_ns_ = 0;
+          if (auto_arriba_ns_ != 0 && ahora - auto_arriba_ns_ >= 3'000'000'000ull && !retenido) {
+            auto_altura_ = 720;
+          }
+        }
+        if (auto_altura_ != altura_interna_) {
+          auto_cambio_ns_ = ahora;
+          auto_abajo_ = auto_arriba_ = 0;
+          auto_abajo_ns_ = auto_arriba_ns_ = 0;
+          auto_descartar_ = 2;
+          REXLOG_INFO("[B3 Deko escala] automatica: GPU {:.2f} ms por quadro (alvo {:.1f} ms) -> {}p", ms, alvo,
+                      auto_altura_);
+        }
+      }
+    }
+  } else {
+    auto_altura_ = altura_interna_ == 360 ? 540 : altura_interna_;
+    auto_abajo_ = auto_arriba_ = 0;
+    auto_abajo_ns_ = auto_arriba_ns_ = 0;
+  }
+  const uint32_t deseada = AlturaInternaDeseada();
+  if (deseada != altura_interna_) {
+    AplicarEscalaInterna(deseada, pedido == 0 ? "automatica" : (deseada != uint32_t(pedido) ? "limitada pela saida" : "cvar"));
+  }
+}
+
+void RenderDk::AplicarEscalaInterna(uint32_t altura, const char* motivo) {
+  const float nueva = altura == 540 ? 0.75f : altura == 360 ? 0.5f : 1.0f;
+  const uint32_t anterior = altura_interna_;
+  const uint64_t inicio = deko::AhoraNs();
+  altura_interna_ = altura;
+  if (nueva == escala_interna_) {
+    return;
+  }
+  if (nucleo_.TrabajoAbierto()) {
+    CerrarTrabajo();
+  }
+  // Nothing keeps a pointer into what is dropped.
+  frontal_.pendiente = false;
+  frontal_ = {};
+  imagenes_pase_.fill(nullptr);
+  sm_destino_ciclo_ = nullptr;
+  sm_destino_ = nullptr;
+  OlvidarEstado();
+  uint32_t imagenes = 0;
+  for (auto& [clave, imagen] : destinos_) {
+    DestruirImagen(imagen);
+    ++imagenes;
+  }
+  destinos_.clear();
+  for (auto& [clave, imagen] : profundidades_) {
+    DestruirImagen(imagen);
+    ++imagenes;
+  }
+  profundidades_.clear();
+  for (ImagenDk& d : desfoque_b3_) {
+    if (d.viva) ++imagenes;
+    DestruirImagen(d);
+  }
+  borrado_previo_.clear();
+  resolves_vistos_.clear();
+  // What was built from resolved textures at their old scale (their faces, slices and cuts are copied rect to rect).
+  for (auto& [clave, a] : apiladas_) DestruirImagen(a.imagen);
+  apiladas_.clear();
+  for (auto& [clave, c] : convertidas_signo_) DestruirImagen(c.imagen);
+  convertidas_signo_.clear();
+  for (auto& [clave, c] : recortadas_) DestruirImagen(c.imagen);
+  recortadas_.clear();
+  for (auto& [clave, v] : volumenes_resueltos_) DestruirImagen(v.imagen);
+  volumenes_resueltos_.clear();
+  for (auto& [clave, b] : bytes_profundidad_) DestruirImagen(b.imagen);
+  bytes_profundidad_.clear();
+  for (auto it = texturas_.begin(); it != texturas_.end();) {
+    if (it->second.desde_resuelta) {
+      bytes_texturas_ -= std::min(bytes_texturas_, it->second.bytes);
+      DestruirImagen(it->second.imagen);
+      it = texturas_.erase(it);
+    } else {
+      ++it;
+    }
+  }
+  escala_interna_ = nueva;
+  ++generacion_texturas_;
+  invalidar_zcull_ = true;
+  ++escala_viva_cambios_;
+  REXLOG_INFO("[B3 Deko escala] troca ao vivo {}p -> {}p ({}): interna={}x{} saida={}x{}; {} alvos/imagens soltos "
+              "(refeitos sob demanda; as texturas resolvidas mudam na proxima copia) em {:.2f} ms; troca {}",
+              anterior, altura, motivo, FisicoCeil(1280, nueva), FisicoCeil(720, nueva), alto_salida_ * 16 / 9,
+              alto_salida_, imagenes, double(deko::AhoraNs() - inicio) / 1e6, escala_viva_cambios_);
+}
+
+void RenderDk::InformeResolves() {
+  const uint64_t cuadros = std::max<uint64_t>(1, fotograma_ - informe_resolve_fotograma_);
+  informe_resolve_fotograma_ = fotograma_;
+  static constexpr const char* kNombres[kHoRazones] = {"ok", "apagado", "parcial_ou_origem", "tamanho_ou_escala",
+                                                       "formato_ou_flags", "sem_borrado_total", "leitura_cpu", "outro"};
+  std::string razones;
+  for (uint32_t r = 0; r < kHoRazones; ++r) {
+    razones += fmt::format("{}{}={}", r ? " " : "", kNombres[r], ho_razones_[r] - ho_informe_razones_[r]);
+    ho_informe_razones_[r] = ho_razones_[r];
+  }
+  REXLOG_INFO("[B3 Deko handover] cvar={} quadros={} resolves_de_cor_por_quadro={:.2f} hechos={} copias_de_qualificados={} "
+              "(total {}/{}); razoes: {}",
+              REXCVAR_GET(b3_deko_handover_cor), cuadros,
+              double(ho_candidatos_) / double(std::max<uint64_t>(fotograma_, 1)),
+              ho_hechos_ - ho_informe_hechos_, ho_copias_ - ho_informe_copias_, ho_hechos_, ho_candidatos_, razones);
+  ho_informe_hechos_ = ho_hechos_;
+  ho_informe_copias_ = ho_copias_;
+  REXLOG_INFO("[B3 Deko resolve repetido] cvar={} resolves_elegiveis={} pulados={} (total {}/{}) por quadro={:.2f}",
+              REXCVAR_GET(b3_deko_pular_resolve_repetido), rr_total_ - rr_informe_total_,
+              rr_saltados_ - rr_informe_saltados_, rr_saltados_, rr_total_,
+              double(rr_saltados_ - rr_informe_saltados_) / double(cuadros));
+  rr_informe_total_ = rr_total_;
+  rr_informe_saltados_ = rr_saltados_;
+}
