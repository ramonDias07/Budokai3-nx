+void RenderDk::CopiarORedimensionar(const ImagenDk& origen, uint32_t x0, uint32_t y0, uint32_t ancho_o,
+                                    uint32_t alto_o, ImagenDk& destino, uint32_t dx, uint32_t dy, uint32_t ancho_d,
+                                    uint32_t alto_d, bool filtrar) {
+  ++destino.escrituras;
+  MarcarGpu(kGpuCopias);
+  AntesDeTransferir();
+  const DkImageView vista_o = VistaCompleta(origen.imagen);
+  const DkImageView vista_d = VistaCompleta(destino.imagen);
+  const DkImageRect a = RectFisico(origen, x0, y0, ancho_o, alto_o);
+  const DkImageRect b = RectFisico(destino, dx, dy, ancho_d, alto_d);
+  if (!filtrar && a.width == b.width && a.height == b.height) {
+    dkCmdBufCopyImage(nucleo_.comandos(), &vista_o, &a, &vista_d, &b, 0);
+  } else {
+    dkCmdBufBlitImage(nucleo_.comandos(), &vista_o, &a, &vista_d, &b, filtrar ? DkBlitFlag_FilterLinear : 0, 0);
+  }
