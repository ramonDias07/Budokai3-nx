+                  REX_SWITCH_PRIO_AUDIO_GUEST < REX_SWITCH_PRIO_GUEST,
+              "guest audio mixer must sit between the presenter and the guest band");
+constexpr size_t kMaxAudioEvents = 4;
+constexpr unsigned kMaxBoostedThreads = 2;
+constexpr uint32_t kMinWaitsBeforeBoost = 16;
+constexpr unsigned kPerfCounterBoostedThreads = 37;  // switch_perf.cpp, absolute count
+
+std::atomic<XObject*> g_audio_events[kMaxAudioEvents];
+std::atomic<uint32_t> g_audio_event_count{0};
+std::atomic<unsigned> g_boosted_threads{0};
+std::mutex g_audio_mixer_mutex;
+
+// Per host thread: -1 not checked yet, 0 no, 1 yes. The Audio Workers are the
+// XHostThreads named "Audio Worker" / "Audio Worker N" by AudioSystem::CreateWorker
+// (set_name appends the handle, so the prefix is compared, as SwitchPriorityFor
+// does). Thread-local cache, so several workers are fine.
+thread_local int8_t t_is_audio_worker = -1;
+// Per thread mixer state: 0 candidate, 1 boosted, 2 never (host/main/failed/disabled).
+thread_local uint8_t t_mixer_state = 0;
+thread_local uint32_t t_mixer_waits = 0;
+
+bool CurrentThreadIsAudioWorker() {
+  if (t_is_audio_worker < 0) {
+    XThread* cur = XThread::GetCurrentThread();
+    bool yes = false;
+    if (cur && !cur->is_guest_thread() && cur->thread()) {
+      yes = std::string_view(cur->thread()->name()).starts_with("Audio Worker");
+    }
+    t_is_audio_worker = yes ? 1 : 0;
+  }
+  return t_is_audio_worker == 1;
