+// Build 0.1.56: CambiarOrdenBytes (xenos.h) fused with the copy: reads `origen`, writes the swapped bytes to `destino`.
+// Same conditions and same result as CambiarOrdenBytes applied to a copy; bytes outside whole units are copied as they are.
+void CopiarConOrdenBytes(uint8_t* destino, const uint8_t* origen, size_t bytes, uint32_t unidad, uint32_t orden) {
+  constexpr uint32_t k8in16 = 1, k8in32 = 2, k16in32 = 3;  // rex::graphics::xenos::Endian
+  if ((unidad == 2 && orden != k8in16) || (unidad != 2 && unidad != 4) || orden == 0) {
+    std::memcpy(destino, origen, bytes);
+    return;
+  }
+  const size_t n = unidad == 2 ? bytes & ~size_t(1) : bytes & ~size_t(3);
+  size_t i = 0;
+#if defined(__aarch64__)
+  for (; i + 16 <= n; i += 16) {
+    const uint8x16_t v = vld1q_u8(origen + i);
+    uint8x16_t r;
+    if (unidad == 2 || orden == k8in16) {
+      r = vrev16q_u8(v);
+    } else if (orden == k8in32) {
+      r = vrev32q_u8(v);
+    } else {
+      r = vreinterpretq_u8_u16(vrev32q_u16(vreinterpretq_u16_u8(v)));
+    }
+    vst1q_u8(destino + i, r);
+  }
+#endif
+  if (unidad == 2 || orden == k8in16) {
+    for (; i + 2 <= n; i += 2) {
+      destino[i] = origen[i + 1];
+      destino[i + 1] = origen[i];
+    }
+  } else if (orden == k8in32) {
+    for (; i + 4 <= n; i += 4) {
+      destino[i] = origen[i + 3];
+      destino[i + 1] = origen[i + 2];
+      destino[i + 2] = origen[i + 1];
+      destino[i + 3] = origen[i];
+    }
+  } else {
+    for (; i + 4 <= n; i += 4) {
+      destino[i] = origen[i + 2];
+      destino[i + 1] = origen[i + 3];
+      destino[i + 2] = origen[i];
+      destino[i + 3] = origen[i + 1];
+    }
+  }
+  if (i < bytes) {
+    std::memcpy(destino + i, origen + i, bytes - i);
+  }
+}
