diff --git a/include/rex/ui/superposicion.h b/include/rex/ui/superposicion.h
new file mode 100644
index 0000000..5071840
--- /dev/null
+++ b/include/rex/ui/superposicion.h
@@ -0,0 +1,23 @@
+// A few lines of text the deko3d presenter paints over the guest output (a game's options menu), centered in a black
+// box with the FPS counter's dot font: no ImGui and no UI drawer, so presentation stays on the game's thread (a UI
+// drawer moves every paint to the UI thread; Dead Space 3's screen went black that way). Upper-case letters, digits,
+// space and . : / ( ) - + > ! , x, plus % ' = (build 0.1.43); lower case letters draw as upper case (except 'x', the
+// times sign). Anything else is blank. The box holds 16 lines of 44 characters and, under them, the marquee line.
+// Thread-safe; an empty list takes it away.
+
+#pragma once
+
+#include <string>
+#include <vector>
+
+namespace rex::ui {
+
+void FijarSuperposicion(std::vector<std::string> lineas);
+// Shows a short notification when the menu is closed. Empty lines clear it.
+void AvisarSuperposicion(std::vector<std::string> lineas);
+// The marquee line: one extra line at the bottom of the menu box. Up to 44 characters it stays still; longer, it scrolls
+// one character every ~6 presented frames (the text, three spaces, the text again). An empty string hides it. It is shown
+// with the menu (FijarSuperposicion), not with the notification (AvisarSuperposicion).
+void FijarLetreiro(std::string texto);
+
+}  // namespace rex::ui
