+  // ---- 0.1.51, the decal (FijarCalcomania / MostrarCalcomania)
+
+  // Picks up what FijarCalcomania changed (one atomic load when nothing did) and uploads a new image; true when the
+  // decal is to be painted this frame (an image, shown, alpha above zero).
+  bool ActualizarCalcomania(DkCmdBuf c) {
+    if (!calco_shader_ok_) return false;
+    Calcomania& k = LaCalcomania();
+    if (k.generacion.load(std::memory_order_acquire) != calco_generacion_) {
+      rex::ui::IconoCompartido imagen;
+      uint64_t generacion;
+      float x, y, w, h;
+      {
+        std::lock_guard<std::mutex> cerrojo(k.candado);
+        imagen = k.imagen;
+        x = k.x;
+        y = k.y;
+        w = k.ancho;
+        h = k.alto;
+        generacion = k.generacion.load(std::memory_order_relaxed);  // consistent with what was copied
+      }
+      if (imagen != calco_fuente_ && !SubirCalcomania(c, imagen)) {
+        return false;  // the upload ring is full this frame: tried again on the next one (the old image is kept)
+      }
+      calco_x_ = x;
+      calco_y_ = y;
+      calco_ancho_ = w;
+      calco_alto_ = h;
+      calco_generacion_ = generacion;
+    }
+    if (!calco_hay_ || !k.visible.load(std::memory_order_relaxed)) return false;
+    calco_alfa_ = std::clamp(k.alfa.load(std::memory_order_relaxed), 0.0f, 1.0f);  // NaN stays NaN: not drawn
+    return calco_alfa_ > 1.0f / 512.0f && calco_ancho_ > 0.0f && calco_alto_ > 0.0f;
+  }
+
+  // The decal's image replaced by `imagen` (null: removed). false only when the upload ring has no room this frame
+  // (nothing changed); a refused image (too large, inconsistent) counts as handled and draws nothing.
+  bool SubirCalcomania(DkCmdBuf c, const rex::ui::IconoCompartido& imagen) {
+    if (!imagen) {
+      LiberarCalcomania();
+      calco_fuente_ = nullptr;
+      return true;
+    }
+    const uint32_t w = imagen->ancho, h = imagen->alto;
+    const size_t bytes = size_t(w) * h * 4;
+    if (!w || !h || w > kCalcomaniaLadoMax || h > kCalcomaniaLadoMax || bytes > kCalcomaniaBytesMax ||
+        imagen->rgba.size() < bytes) {
+      REXLOG_WARN("[deko3d] decal {}x{} (id {}, {} bytes) refused: empty, inconsistent or larger than {}x{} / {} bytes",
+                  w, h, imagen->id, imagen->rgba.size(), kCalcomaniaLadoMax, kCalcomaniaLadoMax, kCalcomaniaBytesMax);
+      LiberarCalcomania();
+      calco_fuente_ = imagen;  // not retried every frame
+      return true;
+    }
+    const Subida subida = nucleo_.Reservar(uint32_t(bytes), 256);
+    if (!subida) return false;
+    // Premultiplied here once (bilinear filtering of straight alpha would darken the edges); then one write pass into
+    // the CPU-uncached upload ring.
+    calco_cpu_.resize(bytes);
+    const uint8_t* p = imagen->rgba.data();
