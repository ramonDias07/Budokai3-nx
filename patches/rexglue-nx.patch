+void RenderDk::VolcarMascaraHud(bool apos_mascara) {
+  const uint32_t id = uint32_t(apos_mascara ? CapturaPosProcesso::HudMascara : CapturaPosProcesso::HudAntes);
+  if (!volcado_swap_ || std::any_of(volcado_.begin(), volcado_.end(),
+                                  [id](const EntradaVolcado& e) { return e.etapa == id; })) return;
+  constexpr uint32_t kBase = 0x530, kAncho = 1280, kAlto = 160;
+  ImagenDk* profundidad = DestinoProfundidad(kBase, 0, kAncho);
+  if (!profundidad || !IniciarVolcado()) return;
+  if (!volcado_hud_.viva &&
+      !CrearImagen(volcado_hud_, DkImageType_2D, DkImageFormat_RGBA8_Unorm, kAncho, kAlto, 1, 1,
+                   DkImageFlags_UsageRender | DkImageFlags_Usage2DEngine, "captura stencil HUD")) return;
+  RestaurarContenido(*profundidad, false);
+  HacerBorradoPendiente(*profundidad);
+  if (Copiar3D(*profundidad, 0, 0, kAncho, kAlto, volcado_hud_, 0, 0, nullptr, true)) {
+    VolcarResuelta(volcado_hud_, kBase, 6, id);
+  }
+}
