+// b3_gpu_boost off: the profile the console had before RexSwitchApmAplicar comes back, and the next call may ask again.
+// Returns 1 = restored ok or nothing to do, 0 = rejected / could not restore.
+extern "C" int RexSwitchApmRestaurar(void) {
+  int resultado = 1;
+  if (g_aplicada.exchange(false)) {
+    ApmPerformanceMode modo = ApmPerformanceMode_Invalid;
+    if (R_FAILED(apmGetPerformanceMode(&modo))) {
+      std::fprintf(stderr, "[apm] restaurar: no se pudo leer el modo de rendimiento\n");
+      resultado = 0;
+    } else if (modo != ApmPerformanceMode_Normal) {
+      std::fprintf(stderr, "[apm] restaurar: consola en sobremesa (modo %d), nada que hacer\n", int(modo));
+    } else {
+      uint32_t config = 0x00020003u;  // stock handheld: GPU 307.2 + EMC 1331.2
+      const bool guardada = g_hay_config_original.load();
+      if (guardada) {
+        config = g_config_original_guardada.load();
+      } else {
+        std::fprintf(stderr, "[apm] restaurar: no habia config original guardada, se usa 0x00020003\n");
+      }
+      const bool ok = R_SUCCEEDED(apmSetPerformanceConfiguration(modo, config));
+      std::fprintf(stderr, "[apm] perfil original 0x%08X restaurado (%s)\n", config,
+                   ok ? "ok" : "RECHAZADO");
+      if (!ok) resultado = 0;
+      // Let the clocks settle, then log what the hardware really runs at.
+      svcSleepThread(500000000ULL);
+      u32 gpu = 0, emc = 0;
+      if (LeerRelojes(gpu, emc)) {
+        std::fprintf(stderr, "[apm] tras restaurar: GPU %.1f MHz, memoria %.1f MHz\n", double(gpu) / 1e6,
+                     double(emc) / 1e6);
+      }
+    }
+  } else {
+    std::fprintf(stderr, "[apm] restaurar: no habia nada aplicado, nada que hacer\n");
+  }
+  g_hay_config_original.store(false);
+  g_emc_original.store(0, std::memory_order_relaxed);  // the watchdog has nothing left to guard
+  g_hecho.store(false);
+  return resultado;
+}
