+
+bool IsAudioEvent(XObject* object) {
+  if (!object) {
+    return false;  // cleared entries are null
+  }
+  const uint32_t n = std::min<uint32_t>(g_audio_event_count.load(std::memory_order_acquire),
+                                        kMaxAudioEvents);
+  for (uint32_t i = 0; i < n; ++i) {
+    if (g_audio_events[i].load(std::memory_order_relaxed) == object) {
+      return true;
+    }
+  }
+  return false;
+}
+
+// Entries cleared because their object was destroyed (the slot can be taken again).
+std::atomic<uint32_t> g_audio_event_free{0};
+
+// XObject destructor hook (xobject.cpp): the registry keeps raw pointers without a reference, so an entry is
+// cleared when its object dies; otherwise a new object allocated at the same address would be taken for the
+// Audio Worker's event (and its waiter boosted as "the mixer"), and the dead entry would fill the registry.
+void NoteObjectDestroyed(XObject* object) {
+  // Lock-free check first: this runs for every object destroyed.
+  if (!IsAudioEvent(object)) {
+    return;
+  }
+  std::lock_guard<std::mutex> lock(g_audio_mixer_mutex);
+  const uint32_t n = std::min<uint32_t>(g_audio_event_count.load(std::memory_order_relaxed), kMaxAudioEvents);
+  for (uint32_t i = 0; i < n; ++i) {
+    if (g_audio_events[i].load(std::memory_order_relaxed) == object) {
+      g_audio_events[i].store(nullptr, std::memory_order_release);
+      g_audio_event_free.fetch_add(1, std::memory_order_relaxed);
+      REXKRNL_INFO("[B3 audio] registered Audio Worker event destroyed, entry {} cleared", i + 1);
+    }
+  }
