+void FijarSuperposicion(std::vector<std::string> lineas) {
+  auto& s = rex::deko3d::LaSuperposicion();
+  std::lock_guard<std::mutex> cerrojo(s.candado);
+  if (lineas == s.lineas) return;
+  s.lineas = std::move(lineas);
+  ++s.version;
+}
+
+void FijarLetreiro(std::string texto) {
+  auto& s = rex::deko3d::LaSuperposicion();
+  std::lock_guard<std::mutex> cerrojo(s.candado);
+  if (texto == s.letreiro) return;
+  s.letreiro = std::move(texto);
+  ++s.version;
+}
+
+void AvisarSuperposicion(std::vector<std::string> lineas) {
+  auto& s = rex::deko3d::LaSuperposicion();
+  std::lock_guard<std::mutex> cerrojo(s.candado);
+  s.aviso = std::move(lineas);
+  s.vence_aviso = std::chrono::steady_clock::now() + std::chrono::seconds(4);
+  ++s.version;
+}
