+  // The overlay: new text into its image when it changed; false when there is none to paint.
+  bool ActualizarMenu(DkCmdBuf c) {
+    Superposicion& s = LaSuperposicion();
+    std::vector<std::string> lineas;
+    std::vector<rex::ui::IconoEnLinea> iconos;
+    uint64_t version;
+    uint32_t filas_aviso = 0;
+    bool copiar_lineas;
+    {
+      std::lock_guard<std::mutex> cerrojo(s.candado);
+      const bool aviso = s.lineas.empty();
+      if (aviso && (s.aviso.empty() || std::chrono::steady_clock::now() >= s.vence_aviso)) return false;
+      copiar_lineas = s.version != menu_version_;
+      if (copiar_lineas) {
+        lineas = aviso ? s.aviso : s.lineas;
+        iconos = aviso ? s.iconos_aviso : s.iconos;
+        if (aviso) filas_aviso = std::min(kMenuFilas, uint32_t(lineas.size()));
+      }
+      // The marquee text is copied only when it can have changed (FijarLetreiro bumps the version), not on every
+      // presented frame.
+      if (!menu_letreiro_copiado_ || s.version != menu_letreiro_version_ || aviso != menu_letreiro_aviso_) {
+        if (aviso) {
+          menu_letreiro_fuente_.clear();
+        } else {
+          menu_letreiro_fuente_ = s.letreiro;
+        }
+        menu_letreiro_version_ = s.version;
+        menu_letreiro_aviso_ = aviso;
+        menu_letreiro_copiado_ = true;
+      }
+      version = s.version;
+    }
+    const std::string& letreiro = menu_letreiro_fuente_;
+    // The marquee: shorter than the box it stays still; longer, it scrolls one character every kLetreiroCuadros
+    // presented frames (the text, three spaces, the text again).
+    std::string& visible = menu_letreiro_tmp_;
+    if (letreiro.size() > kMenuColumnas) {
+      if (letreiro != menu_letreiro_) {
+        menu_letreiro_ = letreiro;
+        menu_letreiro_pos_ = 0;
+        menu_letreiro_cuadros_ = 0;
+      }
+      if (++menu_letreiro_cuadros_ >= kLetreiroCuadros) {
+        menu_letreiro_cuadros_ = 0;
+        ++menu_letreiro_pos_;
+      }
+      // Same characters as (text + "   " + text).substr(pos % period, kMenuColumnas), without building it.
+      const size_t n = letreiro.size();
+      const size_t periodo = n + 3;
+      const size_t inicio = menu_letreiro_pos_ % periodo;
+      visible.clear();
+      for (size_t k = 0; k < kMenuColumnas; ++k) {
+        const size_t j = inicio + k;
+        visible.push_back(j < n ? letreiro[j] : (j < n + 3 ? ' ' : letreiro[j - n - 3]));
+      }
+    } else {
+      visible = letreiro;
+      menu_letreiro_.clear();
+    }
+    if (!copiar_lineas && visible == menu_letreiro_visible_) return true;
+    if (!copiar_lineas && menu_con_letreiro_ && !visible.empty() && !menu_filas_aviso_) {
+      // Only the marquee scrolled: its line alone into the image.
+      const uint32_t y0 = kMenuFilas * kMenuLineaHd + 4 * kMenuHd;  // its cell, from half a line of margin up
+      const uint32_t bytes = kMenuAnchoHd * kMenuLineaHd * 4;
+      const Subida tira = nucleo_.Reservar(bytes, 256);
+      if (!tira) return true;  // the old one stays
+      menu_tira_.resize(bytes);
+      const LienzoMenu lienzo = {menu_tira_.data(), y0, kMenuLineaHd};
+      lienzo.Fondo();
+      PintarLineaMenu(lienzo, visible, kMenuFilas);
+      std::memcpy(tira.cpu, menu_tira_.data(), bytes);  // the upload ring is not CPU-cached: one write pass
+      DkImageView v;
+      dkImageViewDefaults(&v, &menu_imagen_);
+      const DkCopyBuf origen = {tira.gpu, 0, 0};
+      const DkImageRect rect = {0, y0, 0, kMenuAnchoHd, kMenuLineaHd, 1};
+      dkCmdBufCopyBufferToImage(c, &origen, &v, &rect, 0);
+      dkCmdBufBarrier(c, DkBarrier_Full, DkInvalidateFlags_Image);
+      menu_letreiro_visible_ = visible;
+      return true;
+    }
+    if (!copiar_lineas) {
+      lineas = menu_lineas_;  // only the marquee changed
+      iconos = menu_iconos_;
+      filas_aviso = menu_filas_aviso_;
+    }
+    const uint32_t bytes = kMenuAnchoHd * kMenuAltoHd * 4;
+    const Subida subida = nucleo_.Reservar(bytes, 256);
+    if (!subida) return false;
+    menu_lineas_ = lineas;
+    menu_iconos_ = iconos;
+    menu_letreiro_visible_ = visible;
+    menu_con_letreiro_ = !visible.empty() && !filas_aviso;
+    if (menu_con_letreiro_) {
+      lineas.resize(kMenuFilas);
+      lineas.push_back(visible);
+    }
+    menu_cpu_.resize(bytes);
+    const LienzoMenu lienzo = {menu_cpu_.data(), 0, kMenuAltoHd};
+    const uint32_t derecha = RasterizarMenu(lineas, iconos, lienzo);
