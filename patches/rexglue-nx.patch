+void RenderDk::HacerBytesProfundidad(const ImagenDk& profundidad, uint32_t base, const ImagenDk& resuelta, int32_t x0,
+                                     int32_t y0, uint32_t ancho, uint32_t alto, uint32_t dx, uint32_t dy) {
+  BytesProfundidad& b = bytes_profundidad_[base];
+  b.version = UINT64_MAX;
+  const bool nueva = !b.imagen.viva || b.imagen.ancho != resuelta.ancho || b.imagen.alto != resuelta.alto ||
+                     b.imagen.fw() != resuelta.fw() || b.imagen.fh() != resuelta.fh();
+  if (nueva) {
+    if (b.imagen.viva) {
+      DestruirImagen(b.imagen);
+      ++generacion_texturas_;  // the per-fetch cache and the reused textures may name its descriptor
+    }
+    if (!CrearImagen(b.imagen, DkImageType_2D, DkImageFormat_RGBA8_Unorm, resuelta.ancho, resuelta.alto, 1, 1,
+                     DkImageFlags_UsageRender, "profundidad en bytes", resuelta.escala)) {
+      return;
+    }
+    REXLOG_INFO("[deko3d] resuelta de profundidad en {:08X} ({}x{}) leida como color: sus bytes (estencil en X) en "
+                "una imagen aparte",
+                base, resuelta.ancho, resuelta.alto);
+  }
+  bool ok;
+  if (nueva && int32_t(dx) == x0 && int32_t(dy) == y0) {
+    // New: all the target holds, at the same place (a partial resolve leaves the rest as an earlier one had it).
+    ok = Copiar3D(profundidad, 0, 0, std::min(profundidad.ancho, b.imagen.ancho),
+                  std::min(profundidad.alto, b.imagen.alto), b.imagen, 0, 0, nullptr, true);
+  } else {
+    ok = Copiar3D(profundidad, uint32_t(x0), uint32_t(y0), ancho, alto, b.imagen, dx, dy, nullptr, true);
+  }
+  if (ok) {
+    b.version = resuelta.version + 1;  // CopiarProfundidad counts this resolve right after
+  }
+}
