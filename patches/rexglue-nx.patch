+void RenderDk::AvisarEscala(const char* que, uint32_t a, uint32_t b, uint32_t c, bool sin_escala) {
+  const uint64_t clave = (uint64_t(a) << 40) ^ (uint64_t(b) << 20) ^ c ^ std::hash<std::string>{}(que);
