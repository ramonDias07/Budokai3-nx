+// ---- The overlay (rex/ui/superposicion.h): a game's options menu, a few lines in the same dot font
+
+constexpr uint32_t kMenuColumnas = 44;
+constexpr uint32_t kMenuFilas = 16;
+constexpr uint32_t kMenuFilasTotal = kMenuFilas + 1;      // plus the marquee line (FijarLetreiro) at the bottom
+constexpr uint32_t kMenuAncho = (kMenuColumnas + 2) * 6;  // a character of margin each side
+constexpr uint32_t kMenuAlto = (kMenuFilasTotal + 1) * 9;  // half a line of margin above and below
+constexpr uint32_t kLetreiroCuadros = 6;                   // presented frames per character of scroll
+// 0.1.47: the image holds the box at twice that resolution (the same size on screen), rasterized on the CPU: a dot of
+// the normal font is 2x2 texels, one of the small font ('\x01') 1x1, and icons get 16x16 or 32x32 texels.
+constexpr uint32_t kMenuHd = 2;
+constexpr uint32_t kMenuAnchoHd = kMenuAncho * kMenuHd;
+constexpr uint32_t kMenuAltoHd = kMenuAlto * kMenuHd;
+constexpr uint32_t kMenuCeldaHd = 6 * kMenuHd;  // a character's advance
+constexpr uint32_t kMenuLineaHd = 9 * kMenuHd;  // a line's
+
+struct Superposicion {
+  std::mutex candado;
