new file mode 100644
index 0000000..9dbfa15
--- /dev/null
+++ b/src/audio/switch/audio_tempo.h
@@ -0,0 +1,103 @@
+#pragma once
+
+#include <algorithm>
+#include <array>
+#include <cmath>
+#include <cstddef>
+#include <cstdint>
+#include <span>
+
+namespace rex::audio::nx {
+
+// Waveform-similarity overlap-add. The source cursor advances at the game's
+// rate while each output segment keeps the original PCM sample spacing.
+class AudioTempo {
+ public:
+  static constexpr size_t kInputFrames = 256;
+  static constexpr size_t kOutputFrames = 512;
+  using InputBlock = std::array<float, kInputFrames * 2>;
+
+  template <typename ReadInput>
+  void Render(std::span<float, kOutputFrames * 2> output, float rate, ReadInput&& read) {
+    const auto predicted = uint64_t(source_position_);
+    const uint64_t search = warmed_up_ && rate < 0.995f ? kSearch : 0;
+    while (source_end_ < predicted + search + kOutputFrames + kOverlap) {
+      InputBlock block{};
+      read(block.data());
+      std::copy(block.begin(), block.end(), source_.begin() + 2 * (source_end_ % kCapacity));
+      source_end_ += kInputFrames;
+    }
+
+    const uint64_t start = search ? FindAlignedStart(predicted) : predicted;
+    for (size_t frame = 0; frame < kOutputFrames; ++frame) {
+      const auto sample = Sample(start + frame);
+      if (warmed_up_ && frame < kOverlap) {
+        const float mix = float(frame + 1) / float(kOverlap);
+        output[2 * frame] = std::lerp(tail_[2 * frame], sample[0], mix);
+        output[2 * frame + 1] = std::lerp(tail_[2 * frame + 1], sample[1], mix);
+      } else {
+        output[2 * frame] = sample[0];
+        output[2 * frame + 1] = sample[1];
+      }
+    }
+    for (size_t frame = 0; frame < kOverlap; ++frame) {
+      const auto sample = Sample(start + kOutputFrames + frame);
+      tail_[2 * frame] = sample[0];
+      tail_[2 * frame + 1] = sample[1];
+    }
+    warmed_up_ = true;
+    source_position_ += double(rate) * kOutputFrames;
+  }
+
+ private:
+  static constexpr size_t kOverlap = 128;
+  static constexpr uint64_t kSearch = 96;
+  static constexpr uint64_t kCapacity = 2048;
+  static_assert(kCapacity % kInputFrames == 0);
+
+  std::span<const float, 2> Sample(uint64_t frame) const {
+    return std::span<const float, 2>(source_.data() + 2 * (frame % kCapacity), 2);
+  }
+
+  uint64_t FindAlignedStart(uint64_t predicted) const {
+    // Use both channels for a match, with one point every four samples.
+    constexpr int kStep = 4;
+    std::array<float, kOverlap / kStep> reference{};
+    float reference_energy = 0.0f;
+    for (size_t i = 0; i < reference.size(); ++i) {
+      reference[i] = tail_[2 * i * kStep] + tail_[2 * i * kStep + 1];
+      reference_energy += reference[i] * reference[i];
+    }
+    if (reference_energy < 1e-7f) return predicted;
+
+    float best_score = -2.0f;
+    int best_offset = 0;
+    for (int offset = -int(kSearch); offset <= int(kSearch); offset += kStep) {
+      const auto start = int64_t(predicted) + offset;
+      if (start < 0) continue;
+      float dot = 0.0f;
+      float energy = 0.0f;
+      for (size_t i = 0; i < reference.size(); ++i) {
+        const auto sample = Sample(uint64_t(start) + i * kStep);
+        const float mono = sample[0] + sample[1];
+        dot += reference[i] * mono;
+        energy += mono * mono;
+      }
+      const float score = dot / std::sqrt(reference_energy * (energy + 1e-12f)) -
+                          0.0001f * std::abs(offset);
+      if (score > best_score) {
+        best_score = score;
+        best_offset = offset;
+      }
+    }
+    return uint64_t(int64_t(predicted) + best_offset);
+  }
+
+  std::array<float, kCapacity * 2> source_{};
+  std::array<float, kOverlap * 2> tail_{};
+  uint64_t source_end_ = 0;
+  double source_position_ = 0;
+  bool warmed_up_ = false;
+};
+
+}  // namespace rex::audio::nx
