+  // The overlay in the middle of the screen, scaled up by whole steps.
+  void PintarMenu(DkCmdBuf c, uint32_t ancho, uint32_t alto) {
+    // Even: the image has kMenuHd texels per step, sampled 1:1 or 2:1 with nearest filtering.
+    const uint32_t escala =
+        std::max<uint32_t>(2, std::min(ancho * 9 / 10 / kMenuAncho, alto / 3 / kMenuAlto)) / kMenuHd * kMenuHd;
+    const uint32_t alto_usado =
+        menu_filas_aviso_ ? (menu_filas_aviso_ + 1) * 9 : (kMenuFilas + (menu_con_letreiro_ ? 1u : 0u) + 1) * 9;
+    const uint32_t ancho_usado = menu_filas_aviso_ ? menu_ancho_usado_ : kMenuAnchoHd;  // texels of the image
+    const float w = float(ancho_usado * (escala / kMenuHd)) / float(ancho) * 2;
+    const float h = float(alto_usado * escala) / float(alto) * 2;
+    const float x0 = menu_filas_aviso_ ? 0.95f - w : -w / 2;
+    const float y0 = menu_filas_aviso_ ? 0.92f : h / 2;
+    const float datos[8] = {x0, y0, x0 + w, y0 - h, 0, 0, float(ancho_usado) / float(kMenuAnchoHd),
+                            float(alto_usado) / float(kMenuAlto)};
+    const Subida ubo = nucleo_.Reservar(sizeof(datos), DK_UNIFORM_BUF_ALIGNMENT);
+    if (!ubo) return;
+    std::memcpy(ubo.cpu, datos, sizeof(datos));
+    EstadoSinProfundidad(c, false);
+    dkCmdBufBindVtxAttribState(c, nullptr, 0);
+    dkCmdBufBindVtxBufferState(c, nullptr, 0);
+    const DkShader* par[] = {&vs_, &fs_};
+    dkCmdBufBindShaders(c, DkStageFlag_GraphicsMask, par, 2);
+    dkCmdBufBindUniformBuffer(c, DkStage_Vertex, 0, ubo.gpu, sizeof(datos));
+    const DkResHandle h2 = dkMakeTextureHandle(kGuestOutputMailboxSize + 1, 1);  // its image, the nearest sampler
+    dkCmdBufBindTextures(c, DkStage_Fragment, 0, &h2, 1);
+    dkCmdBufDraw(c, DkPrimitive_TriangleStrip, 4, 1, 0, 0);
+  }
