+  // The overlay: new text into its image when it changed; false when there is none to paint.
+  bool ActualizarMenu(DkCmdBuf c) {
+    Superposicion& s = LaSuperposicion();
+    std::vector<std::string> lineas;
+    std::string letreiro;
+    uint64_t version;
+    uint32_t filas_aviso = 0;
+    bool copiar_lineas;
+    {
+      std::lock_guard<std::mutex> cerrojo(s.candado);
+      const bool aviso = s.lineas.empty();
+      if (aviso && (s.aviso.empty() || std::chrono::steady_clock::now() >= s.vence_aviso)) return false;
+      copiar_lineas = s.version != menu_version_;
+      if (copiar_lineas) {
+        lineas = aviso ? s.aviso : s.lineas;
+        if (aviso) filas_aviso = std::min(kMenuFilas, uint32_t(lineas.size()));
+      }
+      if (!aviso) letreiro = s.letreiro;
+      version = s.version;
+    }
+    // The marquee: shorter than the box it stays still; longer, it scrolls one character every kLetreiroCuadros
+    // presented frames (the text, three spaces, the text again).
+    std::string visible = letreiro;
+    if (letreiro.size() > kMenuColumnas) {
+      if (letreiro != menu_letreiro_) {
+        menu_letreiro_ = letreiro;
+        menu_letreiro_pos_ = 0;
+        menu_letreiro_cuadros_ = 0;
+      }
+      if (++menu_letreiro_cuadros_ >= kLetreiroCuadros) {
+        menu_letreiro_cuadros_ = 0;
+        ++menu_letreiro_pos_;
+      }
+      const size_t periodo = letreiro.size() + 3;
+      const std::string doble = letreiro + "   " + letreiro;
+      visible = doble.substr(menu_letreiro_pos_ % periodo, kMenuColumnas);
+    } else {
+      menu_letreiro_.clear();
+    }
+    if (!copiar_lineas && visible == menu_letreiro_visible_) return true;
+    if (!copiar_lineas) {
+      lineas = menu_lineas_;  // only the marquee moved
+      filas_aviso = menu_filas_aviso_;
+    }
+    const Subida subida = nucleo_.Reservar(kMenuAncho * kMenuAlto * 4, 256);
+    if (!subida) return false;
+    menu_lineas_ = lineas;
+    menu_letreiro_visible_ = visible;
+    menu_con_letreiro_ = !visible.empty() && !filas_aviso;
+    if (menu_con_letreiro_) {
+      lineas.resize(kMenuFilas);
+      lineas.push_back(visible);
+    }
+    RasterizarMenu(lineas, subida.cpu);
+    DkImageView v;
+    dkImageViewDefaults(&v, &menu_imagen_);
+    const DkCopyBuf origen = {subida.gpu, 0, 0};
+    const DkImageRect rect = {0, 0, 0, kMenuAncho, kMenuAlto, 1};
+    dkCmdBufCopyBufferToImage(c, &origen, &v, &rect, 0);
+    dkCmdBufBarrier(c, DkBarrier_Full, DkInvalidateFlags_Image);
+    menu_version_ = version;
+    menu_filas_aviso_ = filas_aviso;
+    return true;
+  }
