+
+float RenderDk::EscalaDePitch(uint32_t pitch, const char* que) {
+  if (escala_interna_ == 1.0f) {
+    return 1.0f;
+  }
+  if (pitch < kPitchMinimoEscalado) {
+    AvisarEscala(que, pitch, 0, 0, true);  // tiny targets: the CPU reads their resolves back (exposure 64x8, bloom 80x45)
+    return 1.0f;
+  }
+  return escala_interna_;
