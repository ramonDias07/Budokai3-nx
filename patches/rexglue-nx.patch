+// Matches RENUT_VERTEX_INPUT_LOCATIONS in the shader compiler. The packed
+// location is the rank in the SPIR-V input mask, as in the offline DKSH tool.
+int32_t UbicacionRenut(uint8_t uso, uint8_t indice) {
+  switch (uso) {
+    case 0: return indice <= 4 ? indice : -1;
+    case 1: return indice == 0 ? 14 : -1;
+    case 2: return indice == 0 ? 15 : -1;
+    case 3: return indice == 0 ? 5 : -1;
+    case 5: return indice < 4 ? 8 + indice : (indice <= 10 ? 12 + indice : -1);
+    case 6: return indice == 0 ? 6 : -1;
+    case 7: return indice == 0 ? 7 : -1;
+    case 10: return indice <= 1 ? 12 + indice : -1;
+    default: return -1;
+  }
+}
