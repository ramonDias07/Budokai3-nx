+  const uint32_t formato = (rb_color_info >> 16) & 0xF;
+  const uint64_t clave = (uint64_t(base) << 20) | (uint64_t(formato) << 16) | pitch;
+  const auto it = destinos_.find(clave);
+  if (it == destinos_.end() || it->second.contenido_invalido || it->second.borrado_pendiente ||
+      !IniciarVolcado()) return;
+  VolcarResuelta(it->second, base, formato, etiqueta, 720);
+}
+
+void RenderDk::VolcarEntrada(uint32_t base, uint32_t dibujo, uint32_t ranura) {
+  if (!volcado_swap_) return;
+  const auto it = resueltas_.find(base);
+  if (it == resueltas_.end() || !it->second.escrita || it->second.fotograma_escrito != fotograma_ ||
+      it->second.imagen.profundidad || !IniciarVolcado()) return;
+  constexpr uint32_t kEntrada = 0x20000000u;
+  VolcarResuelta(it->second.imagen, base, it->second.formato_guest, kEntrada | (dibujo << 3) | ranura);
+}
+
+bool RenderDk::IniciarVolcado() {
+  if (volcando_) return true;
+  if (!volcado_bloque_) {
+    volcado_bloque_ = nucleo_.CrearBloqueLectura(kBytesVolcado, "volcado de un fotograma");
+    if (!volcado_bloque_) {
+      REXLOG_WARN("[deko3d] captura Swap={}: memoria de leitura indisponivel", volcado_swap_);
+      return false;
+    }
+    volcado_cpu_ = static_cast<uint8_t*>(dkMemBlockGetCpuAddr(volcado_bloque_));
+    volcado_gpu_ = dkMemBlockGetGpuAddr(volcado_bloque_);
+  }
+  dkMemBlockFlushCpuCache(volcado_bloque_, 0, kBytesVolcado);
+  volcando_ = true;
+  volcado_usados_ = 0;
+  volcado_.clear();
+  sondas_vertices_.clear();
+  return true;
+}
+
+void RenderDk::VolcarResuelta(const ImagenDk& imagen, uint32_t base, uint32_t formato_guest, uint32_t etapa,
+                              uint32_t max_alto, uint32_t x, uint32_t y, uint32_t max_ancho) {
+  const bool textura_b3 = (etapa & 0xF0000000u) == 0x10000000u;
+  uint32_t bpp = 0;
+  switch (imagen.formato) {
+    case DkImageFormat_RGBA8_Unorm:
+    case DkImageFormat_RGB10A2_Unorm:
+    case DkImageFormat_R32_Float:
+    case DkImageFormat_RG16_Float:
+    case DkImageFormat_Z24S8:
+      bpp = 4;
+      break;
+    case DkImageFormat_RGBA16_Float:
+    case DkImageFormat_RG32_Float:
+      bpp = 8;
+      break;
+    case DkImageFormat_RGBA_BC2:
+      if (!textura_b3) return;
+      break;
+    default:
+      return;
+  }
+  if (x >= imagen.fw() || y >= imagen.fh()) return;
+  if (max_alto != UINT32_MAX) max_alto = FisicoCeil(max_alto, imagen.escala);
+  const uint32_t ancho = std::min(imagen.fw() - x, max_ancho);
+  const uint32_t alto = std::min(imagen.fh() - y, max_alto);
+  const uint32_t fila = bpp ? ancho * bpp : ((ancho + 3) / 4) * 16;
+  const uint64_t bytes = uint64_t(fila) * (bpp ? alto : (alto + 3) / 4);
+  const uint64_t alineados = (bytes + 255) & ~uint64_t(255);
+  if (!bytes || volcado_.size() >= 64 || volcado_usados_ + alineados > kBytesVolcado) {
+    return;
+  }
+  AntesDeTransferir();
+  const DkImageView vista = VistaCompleta(imagen.imagen);
+  const DkImageRect rect = {x, y, 0, ancho, alto, 1};
+  const DkCopyBuf destino = {volcado_gpu_ + volcado_usados_, fila, uint32_t(bytes)};
+  dkCmdBufCopyImageToBuffer(nucleo_.comandos(), &vista, &rect, &destino, 0);
+  volcado_.push_back({volcado_usados_, ancho, alto, bpp, base, formato_guest, etapa, imagen.formato,
+                      bpp ? 0u : uint32_t(bytes)});
+  volcado_usados_ += uint32_t(alineados);
+}
+
+void RenderDk::TerminarVolcado() {
+  volcando_ = false;
+  if (volcado_.empty() && sondas_vertices_.empty()) {
+    REXLOG_WARN("[deko3d] captura Swap={}: nenhuma imagem disponivel", volcado_swap_);
+    return;
+  }
+  CerrarTrabajo();
+  proveedor_.dispositivo().EsperarInactiva();
+  dkMemBlockFlushCpuCache(volcado_bloque_, 0, volcado_usados_);  // what the GPU wrote
+  char nombre[128];
+  std::filesystem::path carpeta = rex::filesystem::GetExecutableFolder();
+  if (volcado_swap_) {
+    std::snprintf(nombre, sizeof(nombre), "swap_%06llu_%llu", static_cast<unsigned long long>(volcado_swap_),
+                  static_cast<unsigned long long>(std::time(nullptr)));
+    carpeta /= "b3_deko_diag";
+    carpeta /= "quadros";
+  } else {
+    std::snprintf(nombre, sizeof(nombre), "volcado_foco_%02u", volcados_++);
+  }
+  carpeta /= nombre;
+  std::vector<std::array<SaidaVertice, kVerticesSonda>> sondas_gpu(sondas_vertices_.size());
+  for (size_t i = 0; i < sondas_gpu.size(); ++i) {
+    std::memcpy(sondas_gpu[i].data(), volcado_cpu_ + sondas_vertices_[i].offset, sizeof(sondas_gpu[i]));
+  }
+  // The bytes are copied out here (the block is reused by the next dump); converting and writing them go to a thread of
+  // their own, so the ring thread (and the game waiting on it) does not stop for the SD card.
+  std::vector<std::vector<uint8_t>> copias(volcado_.size());
+  for (size_t n = 0; n < volcado_.size(); ++n) {
+    const EntradaVolcado& e = volcado_[n];
+    const size_t bytes = e.bytes_bc2 ? e.bytes_bc2 : size_t(e.ancho) * e.alto * e.bpp;
+    copias[n].assign(volcado_cpu_ + e.offset, volcado_cpu_ + e.offset + bytes);
+  }
+  REXLOG_INFO("[deko3d] volcado: {} imagens e {} sondas de vertices, se escriben en {}",
+              volcado_.size(), sondas_vertices_.size(), carpeta.string());
+  EncolarEscrituraSd([entradas = std::move(volcado_), copias = std::move(copias), carpeta,
+                      sondas = std::move(sondas_vertices_), gpu = std::move(sondas_gpu)]() {
+  std::error_code ec;
+  std::filesystem::create_directories(carpeta, ec);
+  if (ec) {
+    REXLOG_WARN("[deko3d] captura: nao foi possivel criar {}: {}", carpeta.string(), ec.message());
+    return;
+  }
+  if (!sondas.empty()) {
+    std::ofstream out(carpeta / "xenos_vs_deko.tsv");
+    out << "draw\tvs_container\tps_container\tguest_index\texport\tmask\tcpu_x\tcpu_y\tcpu_z\tcpu_w\t"
+           "gpu_x\tgpu_y\tgpu_z\tgpu_w\tstatus\n";
+    out.precision(9);
+    for (size_t d = 0; d < sondas.size(); ++d) {
+      const SondaVertice& s = sondas[d];
+      uint32_t diferentes = 0, comparados = 0, ausentes = 0;
+      for (uint32_t i = 0; i < s.cantidad; ++i) {
+        const SaidaVertice& cpu = s.cpu[i];
+        const SaidaVertice& dk = gpu[d][i];
+        const bool valido = dk.marca[0] == 0x42335653u && dk.marca[2] == i;
+        if (!valido) ++ausentes;
+        for (uint32_t reg = 0; reg < 17; ++reg) {
+          if (!(cpu.marca[1] & (1u << reg))) continue;
+          const bool tem_gpu = valido && (dk.marca[1] & (1u << reg));
+          bool igual = true;
+          for (uint32_t c = 0; tem_gpu && c < 4; ++c) {
+            if (!(s.mascaras[i][reg] & (1u << c))) continue;
+            const float a = cpu.valores[reg][c], b = dk.valores[reg][c];
+            igual &= a == b || (std::isnan(a) && std::isnan(b)) ||
+                     (std::isfinite(a) && std::isfinite(b) &&
+                      std::abs(a - b) <= 0.00003f * std::max({1.0f, std::abs(a), std::abs(b)}));
+          }
+          comparados += tem_gpu;
+          diferentes += tem_gpu && !igual;
+          out << s.dibujo << '\t' << std::hex << s.vs << '\t' << s.ps << std::dec << '\t'
+              << s.primero + i << '\t' << (reg == 16 ? "position" : std::to_string(reg))
+              << '\t' << uint32_t(s.mascaras[i][reg]);
+          for (float v : cpu.valores[reg]) out << '\t' << v;
+          for (float v : dk.valores[reg]) out << '\t' << v;
+          out << '\t' << (!tem_gpu ? "missing_gpu" : igual ? "match" : "different") << '\n';
+        }
+      }
+      REXLOG_INFO("[B3 Deko VS CPU/GPU] {} desenho={} VS={:016X} PS={:016X} vertices={} "
+                  "sem_resposta_gpu={} exports_comparados={} exports_diferentes={}",
+                  carpeta.filename().string(), s.dibujo, s.vs, s.ps, s.cantidad, ausentes, comparados, diferentes);
+    }
+    out.close();
+    if (!out) REXLOG_WARN("[B3 Deko VS CPU/GPU] erro ao escrever {}", carpeta.string());
+  }
+  char nombre[128];
+  for (size_t n = 0; n < entradas.size(); ++n) {
+    const EntradaVolcado& e = entradas[n];
+    const uint8_t* datos = copias[n].data();
+    const size_t texels = size_t(e.ancho) * e.alto;
+    if ((e.etapa & 0xF0000000u) == 0x10000000u) {
+      const auto name = fmt::format("textura_draw_{:04}_tex{}_base_{:08X}_{}x{}_g{}_dk{}.bin",
+          (e.etapa & 0x0FFFFFFFu) >> 3, e.etapa & 7, e.base, e.ancho, e.alto, e.formato_guest,
+          uint32_t(e.formato));
+      std::ofstream out(carpeta / name, std::ios::binary);
+      out.write(reinterpret_cast<const char*>(datos), std::streamsize(copias[n].size()));
+      out.close();
+      if (!out) REXLOG_WARN("[B3 Deko textura] falha ao escrever {}", name);
+      continue;
+    }
+    if (e.etapa == uint32_t(CapturaPosProcesso::HudAntes) ||
+        e.etapa == uint32_t(CapturaPosProcesso::HudMascara)) {
+      std::vector<uint8_t> gris(texels * 3);
+      uint32_t stencil_uno[2] = {};
+      for (size_t i = 0; i < texels; ++i) {
+        const uint8_t stencil = datos[i * 4];
+        if (stencil == 1) ++stencil_uno[i % e.ancho >= e.ancho / 2];
+        std::fill_n(gris.data() + 3 * i, 3, uint8_t(std::min(255u, uint32_t(stencil) * 64u)));
+      }
+      const bool antes = e.etapa == uint32_t(CapturaPosProcesso::HudAntes);
+      EscribirBmp(carpeta / (antes ? "hud_stencil_antes.bmp" : "hud_stencil_mascara.bmp"), e.ancho, e.alto, gris);
+      REXLOG_INFO("[B3 Deko HUD stencil] {} etapa={} pixels_1_esquerda={} pixels_1_direita={}",
+                  carpeta.filename().string(), antes ? "antes" : "mascara", stencil_uno[0], stencil_uno[1]);
+      continue;
+    }
+    std::vector<float> c(texels * 4, 0.0f);
+    bool alfa = false;
+    for (size_t i = 0; i < texels; ++i) {
+      float* t = &c[i * 4];
+      uint32_t v = 0;
+      std::memcpy(&v, datos + i * e.bpp, 4);
+      switch (e.formato) {
+        case DkImageFormat_RGBA8_Unorm:
+          for (int k = 0; k < 4; ++k) t[k] = float((v >> (8 * k)) & 0xFF) / 255.0f;
+          alfa = true;
+          break;
+        case DkImageFormat_RGB10A2_Unorm:
+          for (int k = 0; k < 3; ++k) t[k] = float((v >> (10 * k)) & 0x3FF) / 1023.0f;
+          t[3] = float(v >> 30) / 3.0f;
+          alfa = true;
+          break;
+        case DkImageFormat_R32_Float:
+          std::memcpy(&t[0], &v, 4);
+          t[1] = t[2] = t[0];
+          break;
+        case DkImageFormat_RG16_Float:
+          t[0] = MedioAFloat(uint16_t(v));
+          t[1] = MedioAFloat(uint16_t(v >> 16));
+          break;
+        case DkImageFormat_RGBA16_Float: {
+          uint16_t h[4];
+          std::memcpy(h, datos + i * 8, 8);
+          for (int k = 0; k < 4; ++k) t[k] = MedioAFloat(h[k]);
+          alfa = true;
+          break;
+        }
+        case DkImageFormat_RG32_Float:
+          std::memcpy(&t[0], datos + i * 8, 4);
+          std::memcpy(&t[1], datos + i * 8 + 4, 4);
+          break;
+        case DkImageFormat_Z24S8:
+          t[0] = float(v & 0xFFFFFF);  // normalized below by the image's range
+          t[3] = float(v >> 24) / 255.0f;
+          break;
+        default:
+          break;
+      }
+    }
+    // Floats and depth are scaled by the image's range, written in the name.
+    const bool profundidad = e.formato == DkImageFormat_Z24S8;
+    const bool flotante = e.formato == DkImageFormat_R32_Float || e.formato == DkImageFormat_RG16_Float ||
+                          e.formato == DkImageFormat_RGBA16_Float || e.formato == DkImageFormat_RG32_Float;
+    float minimo = 0.0f, maximo = 1.0f;
+    if (profundidad || flotante) {
+      minimo = profundidad ? c[0] : 0.0f;
+      maximo = profundidad ? c[0] : 1.0f;
+      for (size_t i = 0; i < texels; ++i) {
+        for (int k = 0; k < (profundidad ? 1 : 3); ++k) {
+          const float x = c[i * 4 + k];
+          if (std::isfinite(x)) {
+            minimo = std::min(minimo, x);
+            maximo = std::max(maximo, x);
+          }
+        }
+      }
+      if (profundidad) {
+        for (size_t i = 0; i < texels; ++i) c[i * 4 + 1] = c[i * 4 + 2] = c[i * 4];
+      }
+    }
+    const float escala = maximo > minimo ? 1.0f / (maximo - minimo) : 1.0f;
+    std::vector<uint8_t> bgr(texels * 3), a(texels * 3);
+    size_t rgb_nao_preto = 0;
+    for (size_t i = 0; i < texels; ++i) {
+      for (int k = 0; k < 3; ++k) {
+        const float x = std::clamp((c[i * 4 + k] - minimo) * escala, 0.0f, 1.0f);
+        bgr[i * 3 + (2 - k)] = std::isfinite(x) ? uint8_t(x * 255.0f + 0.5f) : 0;
+      }
+      if (bgr[i * 3] || bgr[i * 3 + 1] || bgr[i * 3 + 2]) ++rgb_nao_preto;
+      const uint8_t al = uint8_t(std::clamp(c[i * 4 + 3], 0.0f, 1.0f) * 255.0f + 0.5f);
+      a[i * 3] = a[i * 3 + 1] = a[i * 3 + 2] = al;
+    }
+    const std::string hud_etapa = (e.etapa & 0x80000000u)
+        ? fmt::format("hud_draw_{:03}_{}", (e.etapa & 0x7FFFFFFFu) >> 1, e.etapa & 1 ? "depois" : "antes")
+        : std::string{};
+    const std::string dragon_rush_etapa = (e.etapa & 0xF8000000u) == 0x08000000u
+        ? fmt::format("dragon_rush_draw_{:03}", e.etapa & 0x07FFFFFFu) : std::string{};
+    const std::string cena_etapa = (e.etapa & 0x40000000u)
+        ? fmt::format("cena_draw_{:03}_{}", (e.etapa & 0x3FFFFFFFu) >> 1,
+                      e.etapa & 1 ? "depois" : "antes") : std::string{};
+    const std::string entrada_etapa = (e.etapa & 0x20000000u)
+        ? fmt::format("entrada_draw_{:03}_tex{}", (e.etapa & 0x1FFFFFFFu) >> 3, e.etapa & 7)
+        : std::string{};
+    const char* etapa = !hud_etapa.empty() ? hud_etapa.c_str() :
+                        !dragon_rush_etapa.empty() ? dragon_rush_etapa.c_str() :
+                        !cena_etapa.empty() ? cena_etapa.c_str() :
+                        !entrada_etapa.empty() ? entrada_etapa.c_str() :
+                        e.etapa == uint32_t(CapturaPosProcesso::Desfoque) ? "saida_desfoque" :
+                        e.etapa == uint32_t(CapturaPosProcesso::Composicao) ? "cena_antes_hud" :
+                        e.etapa == uint32_t(CapturaPosProcesso::EntradaDesfoque) ? "entrada_desfoque" :
+                        e.etapa == uint32_t(CapturaPosProcesso::EntradaBloom) ? "entrada_bloom" :
+                        e.etapa == 3 ? "antes_resolve" :
+                        e.etapa == 2 ? "saida_apresentador" : e.etapa == 1 ? "fonte_swap" : "resolvida";
+    REXLOG_INFO("[deko3d] captura {} {} base={:08X} {}x{} pixels_rgb_nao_pretos={}/{}",
+                carpeta.filename().string(), etapa, e.base, e.ancho, e.alto, rgb_nao_preto, texels);
+    std::snprintf(nombre, sizeof(nombre), "%02u_%s_%08X_%ux%u_g%u%s_rango_%g_%g", unsigned(n), etapa, e.base,
+                  e.ancho, e.alto, e.formato_guest, profundidad ? "_z" : "", double(minimo), double(maximo));
+    EscribirBmp(carpeta / (std::string(nombre) + ".bmp"), e.ancho, e.alto, bgr);
+    if (alfa && hud_etapa.empty() && dragon_rush_etapa.empty()) {
+      EscribirBmp(carpeta / (std::string(nombre) + "_alfa.bmp"), e.ancho, e.alto, a);
+    }
+  }
+  REXLOG_INFO("[deko3d] volcado: {} texturas escritas en {}", entradas.size(), carpeta.string());
+  });
+  volcado_.clear();
+}
+
+
+// ---- Background writes to the SD card (EncolarEscrituraSd)
+
+void EncolarEscrituraSd(std::function<void()> escritura) {
+  struct Escritor {
+    std::mutex candado;
+    std::condition_variable hay;
+    std::deque<std::function<void()>> cola;
+    std::unique_ptr<rex::thread::Thread> hilo;
+  };
+  static Escritor* e = new Escritor();  // never destroyed: its thread lives as long as the process
+  {
+    std::lock_guard<std::mutex> l(e->candado);
+    e->cola.push_back(std::move(escritura));
+    if (!e->hilo) {
+      e->hilo = rex::thread::Thread::Create({}, [] {
+        for (;;) {
+          std::function<void()> tarea;
+          {
+            std::unique_lock<std::mutex> l(e->candado);
+            e->hay.wait(l, [] { return !e->cola.empty(); });
+            tarea = std::move(e->cola.front());
+            e->cola.pop_front();
+          }
+          tarea();
+        }
+      });
+      if (!e->hilo) {
+        // No thread: done here, as before.
+        auto tarea = std::move(e->cola.back());
+        e->cola.pop_back();
+        tarea();
+        return;
+      }
+    }
+  }
+  e->hay.notify_one();
+}
+
 }  // namespace rex::x360
