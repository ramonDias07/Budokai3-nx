+  // The decal over the guest image: its 1280x720 rectangle mapped into the guest output rectangle (output_x/y and the
+  // last effect's size, the same rectangle the guest image was just drawn into), clipped to it.
+  void PintarCalcomania(DkCmdBuf c, uint32_t ancho, uint32_t alto, float sx, float sy, float sw, float sh) {
+    if (sw <= 0.0f || sh <= 0.0f) return;
+    const float ex = sw / 1280.0f, ey = sh / 720.0f;
+    const float px0 = sx + calco_x_ * ex, px1 = sx + (calco_x_ + calco_ancho_) * ex;
+    const float py0 = sy + calco_y_ * ey, py1 = sy + (calco_y_ + calco_alto_) * ey;
+    const float datos[8] = {px0 / float(ancho) * 2 - 1, 1 - py0 / float(alto) * 2,
+                            px1 / float(ancho) * 2 - 1, 1 - py1 / float(alto) * 2, 0, 0, 1, 1};
+    const float alfa[4] = {calco_alfa_, 0, 0, 0};
+    const Subida ubo = nucleo_.Reservar(sizeof(datos), DK_UNIFORM_BUF_ALIGNMENT);
+    const Subida ubo_alfa = nucleo_.Reservar(sizeof(alfa), DK_UNIFORM_BUF_ALIGNMENT);
+    if (!ubo || !ubo_alfa) return;
+    std::memcpy(ubo.cpu, datos, sizeof(datos));
+    std::memcpy(ubo_alfa.cpu, alfa, sizeof(alfa));
+    // Clipped to the guest rectangle (never over the letterbox); the full target restored after.
+    const int32_t cx0 = std::clamp(int32_t(sx), 0, int32_t(ancho)), cy0 = std::clamp(int32_t(sy), 0, int32_t(alto));
+    const int32_t cx1 = std::clamp(int32_t(sx + sw + 0.5f), cx0, int32_t(ancho));
+    const int32_t cy1 = std::clamp(int32_t(sy + sh + 0.5f), cy0, int32_t(alto));
+    if (cx1 <= cx0 || cy1 <= cy0) return;
+    const DkScissor tijera = {uint32_t(cx0), uint32_t(cy0), uint32_t(cx1 - cx0), uint32_t(cy1 - cy0)};
+    dkCmdBufSetScissors(c, 0, &tijera, 1);
+    EstadoSinProfundidad(c, true);
+    DkBlendState bs;  // premultiplied: src One instead of SrcAlpha
+    dkBlendStateDefaults(&bs);
+    bs.srcColorBlendFactor = DkBlendFactor_One;
+    bs.dstColorBlendFactor = DkBlendFactor_InvSrcAlpha;
+    bs.srcAlphaBlendFactor = DkBlendFactor_One;
+    bs.dstAlphaBlendFactor = DkBlendFactor_InvSrcAlpha;
+    dkCmdBufBindBlendState(c, 0, &bs);
+    dkCmdBufBindVtxAttribState(c, nullptr, 0);
+    dkCmdBufBindVtxBufferState(c, nullptr, 0);
+    const DkShader* par[] = {&vs_, &fs_calco_};
+    dkCmdBufBindShaders(c, DkStageFlag_GraphicsMask, par, 2);
+    dkCmdBufBindUniformBuffer(c, DkStage_Vertex, 0, ubo.gpu, sizeof(datos));
+    dkCmdBufBindUniformBuffer(c, DkStage_Fragment, 0, ubo_alfa.gpu, sizeof(alfa));
+    const DkResHandle h = dkMakeTextureHandle(kGuestOutputMailboxSize + 2, 0);  // its image, the linear sampler
+    dkCmdBufBindTextures(c, DkStage_Fragment, 0, &h, 1);
+    dkCmdBufDraw(c, DkPrimitive_TriangleStrip, 4, 1, 0, 0);
+    const DkScissor completa = {0, 0, ancho, alto};
+    dkCmdBufSetScissors(c, 0, &completa, 1);
+  }
