+    // rewritten (only when the image changes).
+    dkCmdBufBarrier(c, DkBarrier_Full, 0);
+    DkImageView v;
+    dkImageViewDefaults(&v, &calco_imagen_);
+    DkImageDescriptor d;
+    dkImageDescriptorInitialize(&d, &v, false, false);
+    dkCmdBufPushData(c, nucleo_.DescriptoresImagen() + (kGuestOutputMailboxSize + 2) * sizeof(d), &d, sizeof(d));
+    const DkCopyBuf origen = {subida.gpu, 0, 0};
