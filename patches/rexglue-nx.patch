+  // samples along each axis; the 1x view addresses each as one pixel.
+  ImagenDk* profundidad = escribir_z || mascara_estencil
+      ? DestinoProfundidad(rb_depth_info & 0x7FF, (rb_depth_info >> 16) & 1, pitch * 2) : nullptr;
+  if ((escribir_z || mascara_estencil) && !profundidad) return false;
+  ImagenDk* destino = color ? DestinoColor(rb_color_info & 0x7FF, (rb_color_info >> 16) & 0xF, pitch * 2) : nullptr;
+  if (color && !destino) return false;
+  if (destino) {
+    BorrarRectangulo(*destino, x0 * 2, y0 * 2, x1 * 2, y1 * 2, color, 0.0f, 0);
+  }
+  if (profundidad) {
+    BorrarRectangulo(*profundidad, x0 * 2, y0 * 2, x1 * 2, y1 * 2, nullptr, z, estencil,
+                    !escribir_z, mascara_estencil);
+  }
