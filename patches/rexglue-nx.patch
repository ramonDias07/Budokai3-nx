+      const uint32_t a = p[i + 3];
+      t[i + 0] = uint8_t((uint32_t(p[i + 0]) * a + 127) / 255);
+      t[i + 1] = uint8_t((uint32_t(p[i + 1]) * a + 127) / 255);
+      t[i + 2] = uint8_t((uint32_t(p[i + 2]) * a + 127) / 255);
+      t[i + 3] = uint8_t(a);
