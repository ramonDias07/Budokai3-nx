diff --git a/include/rex/filesystem/file_overlay.h b/include/rex/filesystem/file_overlay.h
new file mode 100644
index 0000000..7785942
--- /dev/null
+++ b/include/rex/filesystem/file_overlay.h
@@ -0,0 +1,41 @@
+/**
+ * File overlay hook for read-only host path devices (Budokai 3 port, build 0.1.52).
+ *
+ * Lets the application present some game files with different contents and size without touching the
+ * files on disk. The SDK only asks two questions: how big a file looks (when its entry is created or
+ * refreshed) and which File object the guest gets when it opens it. Everything else (what the bytes
+ * are, where they come from) lives in the application.
+ *
+ * Only consulted for files on read-only devices: saves and profiles are never overlaid.
+ */
+
+#pragma once
+
+#include <cstdint>
+#include <filesystem>
+
+namespace rex::filesystem {
+
+class Entry;
+class File;
+
+class FileOverlay {
+ public:
+  virtual ~FileOverlay() = default;
+
+  // True if host_path is overlaid; then *virtual_size is the size the guest must see. real_size is
+  // the size of the file on disk.
+  virtual bool VirtualSize(const std::filesystem::path& host_path, uint64_t real_size,
+                           uint64_t* virtual_size) = 0;
+
+  // Called after host_path was opened as `inner`. Returns the file handed to the guest: `inner` itself
+  // when the path is not overlaid, or a wrapper that takes ownership of `inner`.
+  virtual File* Wrap(const std::filesystem::path& host_path, uint32_t desired_access, Entry* entry,
+                     File* inner) = 0;
+};
+
+// Install before the VFS is set up (entries created earlier keep their real size). nullptr removes it.
+void SetFileOverlay(FileOverlay* overlay);
+FileOverlay* GetFileOverlay();
+
+}  // namespace rex::filesystem
