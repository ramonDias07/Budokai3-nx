+void RenderDk::VolcarDragonRush(uint32_t pitch, uint32_t dibujo) {
+  if (!volcado_swap_) return;
+  const auto it = destinos_.find(pitch);  // base 0, color format 0
+  if (it == destinos_.end() || it->second.contenido_invalido || it->second.borrado_pendiente ||
+      !IniciarVolcado()) return;
+  constexpr uint32_t kDragonRush = 0x08000000u;
+  VolcarResuelta(it->second, 0, 0, kDragonRush | dibujo, 160, 480, 520, 320);
+}
