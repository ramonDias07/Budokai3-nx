+// 0.1.51, the decal (rex/ui/superposicion.h, FijarCalcomania/MostrarCalcomania). The image and its rectangle under the
+// lock (set rarely); the generation, the visibility and the alpha are atomics the paint thread reads every frame.
+struct Calcomania {
+  std::mutex candado;
+  rex::ui::IconoCompartido imagen;
+  float x = 0, y = 0, ancho = 0, alto = 0;  // in the guest's 1280x720 frame
+  std::atomic<uint64_t> generacion{0};      // bumped under the lock by every FijarCalcomania that changes something
+  std::atomic<bool> visible{false};
+  std::atomic<float> alfa{1.0f};
+};
+Calcomania& LaCalcomania() {
