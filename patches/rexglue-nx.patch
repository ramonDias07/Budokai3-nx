+
+// Called from the set/pulse event shims.
+void NoteEventSignal(XObject* object) {
+  if (!object || (g_audio_event_count.load(std::memory_order_relaxed) >= kMaxAudioEvents &&
+                  g_audio_event_free.load(std::memory_order_relaxed) == 0)) {
+    return;
+  }
+  if (!CurrentThreadIsAudioWorker() || IsAudioEvent(object)) {
+    return;
+  }
+  std::lock_guard<std::mutex> lock(g_audio_mixer_mutex);
+  if (IsAudioEvent(object)) {
+    return;
+  }
+  const uint32_t n = g_audio_event_count.load(std::memory_order_relaxed);
+  uint32_t slot = n;
+  if (n >= kMaxAudioEvents) {
+    // Full: reuse an entry whose object was destroyed.
+    slot = kMaxAudioEvents;
+    for (uint32_t i = 0; i < kMaxAudioEvents; ++i) {
+      if (!g_audio_events[i].load(std::memory_order_relaxed)) {
+        slot = i;
+        break;
+      }
+    }
+    if (slot == kMaxAudioEvents) {
+      return;
+    }
+    g_audio_event_free.fetch_sub(1, std::memory_order_relaxed);
+  }
+  // Set before the entry exists, so its destruction is always seen.
+  rex::system::g_xobject_destroyed_hook.store(&NoteObjectDestroyed, std::memory_order_release);
+  g_audio_events[slot].store(object, std::memory_order_release);
+  if (slot == n) {
+    g_audio_event_count.store(n + 1, std::memory_order_release);
+  }
+  REXKRNL_INFO("[B3 audio] event signalled by an Audio Worker registered (entry {}/{}): handle {:08X}",
+               slot + 1, kMaxAudioEvents, object->handle());
+}
+
+// Called from the wait shims, before blocking, so the wake-up already runs at
+// the raised priority.
+void NoteGuestWait(XObject* const* objects, uint32_t count) {
+  if (t_mixer_state != 0 || g_audio_event_count.load(std::memory_order_relaxed) == 0) {
+    return;
+  }
+  bool hit = false;
+  for (uint32_t i = 0; i < count && !hit; ++i) {
+    hit = IsAudioEvent(objects[i]);
+  }
+  if (!hit) {
+    return;
+  }
+  XThread* cur = XThread::GetCurrentThread();
+  if (!cur || !cur->is_guest_thread() || cur->main_thread() || CurrentThreadIsAudioWorker() ||
+      !REXCVAR_GET(audio_switch_prioridad_mezclador)) {
+    t_mixer_state = 2;
+    return;
+  }
+  if (++t_mixer_waits < kMinWaitsBeforeBoost) {
+    return;
+  }
+  std::lock_guard<std::mutex> lock(g_audio_mixer_mutex);
+  if (g_boosted_threads.load(std::memory_order_relaxed) >= kMaxBoostedThreads) {
+    t_mixer_state = 2;
+    return;
+  }
+  const std::string name = cur->thread() ? cur->thread()->name() : std::string("?");
+  if (!RexSwitchSetCurrentThreadPriorityOk(REX_SWITCH_PRIO_AUDIO_GUEST)) {
+    t_mixer_state = 2;
+    REXKRNL_WARN("[B3 audio] game mixer thread detected: {} ({:08X}), but the kernel refused "
+                 "priority 0x{:X}; it stays at 0x{:X}",
+                 name, cur->handle(), REX_SWITCH_PRIO_AUDIO_GUEST, REX_SWITCH_PRIO_GUEST);
+    return;
+  }
+  t_mixer_state = 1;
+  const unsigned boost_index = g_boosted_threads.fetch_add(1, std::memory_order_relaxed);
+  RexSwitchPerfAdd(kPerfCounterBoostedThreads, 1);
+  // Distinct preferred cores (see "Cores" above): 1 for the first mixer, 2 for the second.
+  int core = -1;
+  if (REXCVAR_GET(audio_parallel_client_callbacks)) {
+    core = int(1 + boost_index);
+    if (!RexSwitchSetCurrentThreadCore(core)) {
+      core = -1;
+    }
+  }
+  REXKRNL_INFO("[B3 audio] game mixer thread detected: {} ({:08X}), priority 0x{:X} -> 0x{:X}, "
+               "preferred core {}",
+               name, cur->handle(), REX_SWITCH_PRIO_GUEST, REX_SWITCH_PRIO_AUDIO_GUEST, core);
+}
